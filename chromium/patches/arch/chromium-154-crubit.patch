+use alloc::{boxed::Box, vec::Vec};
+
+use crate::{AthmClientRequest, AthmKeyMaterial, AthmParameters, AthmStatus, TokenRequest};
+
+#[cxx::bridge(namespace = "private_verification_tokens")]
+mod ffi {
+    enum AthmStatus {
+        Ok,
+        InvalidInput,
+        OperationFailed,
+    }
+
+    extern "Rust" {
+        type CxxAthmKeyMaterial;
+        type CxxAthmParameters;
+        type CxxAthmClientRequest;
+        type CxxTokenRequest;
+
+        type AthmKeyMaterialNewResult;
+        fn athm_key_material_new_err(self: &AthmKeyMaterialNewResult) -> bool;
+        fn athm_key_material_new_status(self: &AthmKeyMaterialNewResult) -> AthmStatus;
+        fn athm_key_material_new_unwrap(self: &mut AthmKeyMaterialNewResult) -> Box<CxxAthmKeyMaterial>;
+
+        type AthmBytesResult;
+        fn athm_bytes_result_err(self: &AthmBytesResult) -> bool;
+        fn athm_bytes_result_status(self: &AthmBytesResult) -> AthmStatus;
+        fn athm_bytes_result_unwrap(self: &mut AthmBytesResult) -> Vec<u8>;
+
+        type AthmVerifyResult;
+        fn athm_verify_result_err(self: &AthmVerifyResult) -> bool;
+        fn athm_verify_result_status(self: &AthmVerifyResult) -> AthmStatus;
+        fn athm_verify_result_unwrap(self: &mut AthmVerifyResult) -> u8;
+
+        type AthmParametersNewResult;
+        fn athm_parameters_new_err(self: &AthmParametersNewResult) -> bool;
+        fn athm_parameters_new_status(self: &AthmParametersNewResult) -> AthmStatus;
+        fn athm_parameters_new_unwrap(self: &mut AthmParametersNewResult) -> Box<CxxAthmParameters>;
+
+        type AthmClientRequestNewResult;
+        fn athm_client_request_new_err(self: &AthmClientRequestNewResult) -> bool;
+        fn athm_client_request_new_status(self: &AthmClientRequestNewResult) -> AthmStatus;
+        fn athm_client_request_new_unwrap(self: &mut AthmClientRequestNewResult) -> Box<CxxAthmClientRequest>;
+
+        type AthmTokenRequestDecodeResult;
+        fn token_request_decode_err(self: &AthmTokenRequestDecodeResult) -> bool;
+        fn token_request_decode_status(self: &AthmTokenRequestDecodeResult) -> AthmStatus;
+        fn token_request_decode_unwrap(self: &mut AthmTokenRequestDecodeResult) -> Box<CxxTokenRequest>;
+
+        fn athm_key_material_new(
+            num_buckets: u8,
+            deployment_id: &[u8],
+        ) -> Box<AthmKeyMaterialNewResult>;
+
+        fn athm_key_material_public_key(key_material: &CxxAthmKeyMaterial) -> Vec<u8>;
+
+        fn athm_key_material_public_key_proof(key_material: &CxxAthmKeyMaterial) -> Vec<u8>;
+
+        fn athm_key_material_issue(
+            key_material: &CxxAthmKeyMaterial,
+            request: &CxxTokenRequest,
+            hidden_metadata: u8,
+        ) -> Box<AthmBytesResult>;
+
+        fn athm_key_material_verify(
+            key_material: &CxxAthmKeyMaterial,
+            token: &[u8],
+        ) -> Box<AthmVerifyResult>;
+
+        fn athm_parameters_new(
+            num_buckets: u8,
+            deployment_id: &[u8],
