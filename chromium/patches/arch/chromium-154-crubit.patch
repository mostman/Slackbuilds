--- a/components/web_package/signed_web_bundles/rust/cxx_ffi.rs	1970-01-01 01:00:00.000000000 +0100
+++ b/components/web_package/signed_web_bundles/rust/cxx_ffi.rs	2026-10-29 16:04:59.310318836 +0100
@@ -0,0 +1,232 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+use alloc::{borrow::ToOwned, boxed::Box, string::String, vec::Vec};
+
+use crate::{
+    create_empty_integrity_block_cbor, create_signature_payload,
+    parse_integrity_block, verify_ecdsa_p256_signature,
+    verify_ed25519_signature, Sha512Hasher,
+};
+
+#[cxx::bridge(namespace = "web_package::signed_web_bundles::rust")]
+mod ffi {
+    enum SignatureType {
+        Ed25519,
+        EcdsaP256SHA256,
+        Unknown,
+    }
+
+    extern "Rust" {
+        type IntegrityBlockResult;
+
+        fn err(self: &IntegrityBlockResult) -> bool;
+        fn unwrap(self: &mut IntegrityBlockResult) -> Box<CxxIntegrityBlock>;
+        fn error_message(self: &IntegrityBlockResult) -> String;
+        fn error_is_version_error(self: &IntegrityBlockResult) -> bool;
+
+        type CxxIntegrityBlock;
+
+        fn size(self: &CxxIntegrityBlock) -> usize;
+        fn web_bundle_id(self: &CxxIntegrityBlock) -> String;
+        fn attributes_cbor(self: &CxxIntegrityBlock) -> Vec<u8>;
+        fn signature_stack_size(self: &CxxIntegrityBlock) -> usize;
+        fn signature_stack_entry(
+            self: &CxxIntegrityBlock,
+            index: usize,
+        ) -> Box<CxxSignatureStackEntry>;
+
+        type CxxSignatureStackEntry;
+
+        fn signature_stack_entry_attributes_cbor(
+            self: &CxxSignatureStackEntry,
+        ) -> Vec<u8>;
+        fn signature_type(self: &CxxSignatureStackEntry) -> SignatureType;
+        fn public_key(self: &CxxSignatureStackEntry) -> Vec<u8>;
+        fn signature(self: &CxxSignatureStackEntry) -> Vec<u8>;
+
+        fn parse_integrity_block_ffi(input: &[u8]) -> Box<IntegrityBlockResult>;
+
+        fn create_empty_integrity_block_cbor(
+            attributes_cbor: &[u8],
+        ) -> Vec<u8>;
+
+        fn create_signature_payload(
+            unsigned_web_bundle_hash: &[u8],
+            integrity_block_cbor: &[u8],
+            attributes_cbor: &[u8],
+        ) -> Vec<u8>;
+
+        fn verify_ed25519_signature(
+            public_key: &[u8],
+            signature: &[u8],
+            message: &[u8],
+        ) -> bool;
+
+        fn verify_ecdsa_p256_signature(
+            public_key: &[u8],
+            signature: &[u8],
+            message: &[u8],
+        ) -> bool;
+
+        type Sha512Hasher;
+
+        fn new_sha512_hasher() -> Box<Sha512Hasher>;
+        fn sha512_update(self: &mut Sha512Hasher, chunk: &[u8]);
+        fn sha512_finish(self: &mut Sha512Hasher) -> Vec<u8>;
+    }
+}
+
+struct IntegrityBlockResult {
+    block: Option<CxxIntegrityBlock>,
+    error: Option<crate::ParseError>,
+}
+
+struct CxxIntegrityBlock {
+    size: usize,
+    web_bundle_id: String,
+    attributes_cbor: Vec<u8>,
+    signature_stack: Vec<CxxSignatureStackEntry>,
+}
+
+struct CxxSignatureStackEntry {
+    attributes_cbor: Vec<u8>,
+    signature_type: crate::SignatureType,
+    public_key: Vec<u8>,
+    signature: Vec<u8>,
+}
+
+fn parse_integrity_block_ffi(input: &[u8]) -> Box<IntegrityBlockResult> {
+    match parse_integrity_block(input) {
+        Ok(block) => Box::new(IntegrityBlockResult {
+            block: Some(CxxIntegrityBlock {
+                size: block.size,
+                web_bundle_id: block.web_bundle_id.to_owned(),
+                attributes_cbor: block.attributes_cbor,
+                signature_stack: block
+                    .signature_stack
+                    .into_iter()
+                    .map(|entry| CxxSignatureStackEntry {
+                        attributes_cbor: entry.attributes_cbor,
+                        signature_type: entry.signature_type,
+                        public_key: entry.public_key.to_vec(),
+                        signature: entry.signature.to_vec(),
+                    })
+                    .collect(),
+            }),
+            error: None,
+        }),
+
+        Err(error) => Box::new(IntegrityBlockResult {
+            block: None,
+            error: Some(error),
+        }),
+    }
+}
+
+impl IntegrityBlockResult {
+    fn err(&self) -> bool {
+        self.error.is_some()
+    }
+
+    fn unwrap(&mut self) -> Box<CxxIntegrityBlock> {
+        Box::new(self.block.take().expect("called unwrap on an error"))
+    }
+
+    fn error_message(&self) -> String {
+        self.error
+            .as_ref()
+            .expect("called error_message on a successful result")
+            .message
+            .clone()
+    }
+
+    fn error_is_version_error(&self) -> bool {
+        self.error
+            .as_ref()
+            .expect("called error_is_version_error on a successful result")
+            .is_version_error
+    }
+}
+
+impl CxxIntegrityBlock {
+    fn size(&self) -> usize {
+        self.size
+    }
+
+    fn web_bundle_id(&self) -> String {
+        self.web_bundle_id.clone()
+    }
+
+    fn attributes_cbor(&self) -> Vec<u8> {
+        self.attributes_cbor.clone()
+    }
+
+    fn signature_stack_size(&self) -> usize {
+        self.signature_stack.len()
+    }
+
+    fn signature_stack_entry(
+        &self,
+        index: usize,
+    ) -> Box<CxxSignatureStackEntry> {
+        Box::new(
+            self.signature_stack
+                .get(index)
+                .expect("signature stack index out of bounds")
+                .clone(),
+        )
+    }
+}
+
+impl CxxSignatureStackEntry {
+    fn signature_stack_entry_attributes_cbor(&self) -> Vec<u8> {
+        self.attributes_cbor.clone()
+    }
+
+    fn signature_type(&self) -> ffi::SignatureType {
+        match self.signature_type {
+            crate::SignatureType::Ed25519 => ffi::SignatureType::Ed25519,
+            crate::SignatureType::EcdsaP256SHA256 => {
+                ffi::SignatureType::EcdsaP256SHA256
+            }
+            crate::SignatureType::Unknown => ffi::SignatureType::Unknown,
+        }
+    }
+
+    fn public_key(&self) -> Vec<u8> {
+        self.public_key.clone()
+    }
+
+    fn signature(&self) -> Vec<u8> {
+        self.signature.clone()
+    }
+}
+
+fn new_sha512_hasher() -> Box<Sha512Hasher> {
+    Box::new(Sha512Hasher::new())
+}
+
+impl Sha512Hasher {
+    fn sha512_update(&mut self, chunk: &[u8]) {
+        self.update(chunk);
+    }
+
+    fn sha512_finish(&mut self) -> Vec<u8> {
+        core::mem::replace(self, Sha512Hasher::new())
+            .finish()
+            .to_vec()
+    }
+}
+
+impl Clone for CxxSignatureStackEntry {
+    fn clone(&self) -> Self {
+        Self {
+            attributes_cbor: self.attributes_cbor.clone(),
+            signature_type: self.signature_type,
+            public_key: self.public_key.clone(),
+            signature: self.signature.clone(),
+        }
+    }
+}
