@@ -0,0 +1,161 @@
+use alloc::{boxed::Box, vec::Vec};
+
+use crate::{AthmClientRequest, AthmKeyMaterial, AthmParameters, AthmStatus, TokenRequest};
+
+#[cxx::bridge(namespace = "private_verification_tokens")]
+mod ffi {
+    enum AthmStatus {
+        InvalidInput,
+        OperationFailed,
+    }
+
+    extern "Rust" {
+        type CxxAthmKeyMaterial;
+        type CxxAthmParameters;
+        type CxxAthmClientRequest;
+        type CxxTokenRequest;
+
+        fn athm_key_material_new(
+            num_buckets: u8,
+            deployment_id: &[u8],
+        ) -> Result<Box<CxxAthmKeyMaterial>, AthmStatus>;
+
+        fn athm_key_material_public_key(
+            key_material: &CxxAthmKeyMaterial,
+        ) -> Vec<u8>;
+
+        fn athm_key_material_public_key_proof(
+            key_material: &CxxAthmKeyMaterial,
+        ) -> Vec<u8>;
+
+        fn athm_key_material_issue(
+            key_material: &CxxAthmKeyMaterial,
+            request: &CxxTokenRequest,
+            hidden_metadata: u8,
+        ) -> Result<Vec<u8>, AthmStatus>;
+
+        fn athm_key_material_verify(
+            key_material: &CxxAthmKeyMaterial,
+            token: &[u8],
+        ) -> Result<u8, AthmStatus>;
+
+        fn athm_parameters_new(
+            num_buckets: u8,
+            deployment_id: &[u8],
+        ) -> Result<Box<CxxAthmParameters>, AthmStatus>;
+
+        fn athm_parameters_token_response_size(
+            params: &CxxAthmParameters,
+        ) -> usize;
+
+        fn athm_client_request_new(
+            public_key: &[u8],
+            public_key_proof: &[u8],
+            params: &CxxAthmParameters,
+        ) -> Result<Box<CxxAthmClientRequest>, AthmStatus>;
+
+        fn athm_client_request_request(
+            request: &CxxAthmClientRequest,
+        ) -> Vec<u8>;
+
+        fn athm_client_request_finalize(
+            request: &CxxAthmClientRequest,
+            public_key: &[u8],
+            response: &[u8],
+            params: &CxxAthmParameters,
+        ) -> Result<Vec<u8>, AthmStatus>;
+
+        fn token_request_decode(
+            bytes: &[u8],
+        ) -> Result<Box<CxxTokenRequest>, AthmStatus>;
+    }
+}
+
+struct CxxAthmKeyMaterial(AthmKeyMaterial);
+struct CxxAthmParameters(AthmParameters);
+struct CxxAthmClientRequest(AthmClientRequest);
+struct CxxTokenRequest(TokenRequest);
+
+fn athm_key_material_new(
+    num_buckets: u8,
+    deployment_id: &[u8],
+) -> Result<Box<CxxAthmKeyMaterial>, AthmStatus> {
+    AthmKeyMaterial::try_new(num_buckets, deployment_id)
+        .map(|value| Box::new(CxxAthmKeyMaterial(value)))
+}
+
+fn athm_key_material_public_key(
+    key_material: &CxxAthmKeyMaterial,
+) -> Vec<u8> {
+    key_material.0.public_key()
+}
+
+fn athm_key_material_public_key_proof(
+    key_material: &CxxAthmKeyMaterial,
+) -> Vec<u8> {
+    key_material.0.public_key_proof()
+}
+
+fn athm_key_material_issue(
+    key_material: &CxxAthmKeyMaterial,
+    request: &CxxTokenRequest,
+    hidden_metadata: u8,
+) -> Result<Vec<u8>, AthmStatus> {
+    key_material.0.issue(&request.0, hidden_metadata)
+}
+
+fn athm_key_material_verify(
+    key_material: &CxxAthmKeyMaterial,
+    token: &[u8],
+) -> Result<u8, AthmStatus> {
+    key_material.0.verify(token)
+}
+
+fn athm_parameters_new(
+    num_buckets: u8,
+    deployment_id: &[u8],
+) -> Result<Box<CxxAthmParameters>, AthmStatus> {
+    AthmParameters::try_new(num_buckets, deployment_id)
+        .map(|value| Box::new(CxxAthmParameters(value)))
+}
+
+fn athm_parameters_token_response_size(
+    params: &CxxAthmParameters,
+) -> usize {
+    params.0.token_response_size()
+}
+
+fn athm_client_request_new(
+    public_key: &[u8],
+    public_key_proof: &[u8],
+    params: &CxxAthmParameters,
+) -> Result<Box<CxxAthmClientRequest>, AthmStatus> {
+    AthmClientRequest::try_new(
+        public_key,
+        public_key_proof,
+        &params.0,
+    )
+    .map(|value| Box::new(CxxAthmClientRequest(value)))
+}
+
+fn athm_client_request_request(
+    request: &CxxAthmClientRequest,
+) -> Vec<u8> {
+    request.0.request()
+}
+
+fn athm_client_request_finalize(
+    request: &CxxAthmClientRequest,
+    public_key: &[u8],
+    response: &[u8],
+    params: &CxxAthmParameters,
+) -> Result<Vec<u8>, AthmStatus> {
+    request.0.finalize(public_key, response, &params.0)
+}
+
+fn token_request_decode(
+    bytes: &[u8],
+) -> Result<Box<CxxTokenRequest>, AthmStatus> {
+    TokenRequest::decode(bytes)
+        .map(|value| Box::new(CxxTokenRequest(value)))
+}
