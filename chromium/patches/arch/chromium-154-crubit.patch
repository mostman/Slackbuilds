+        fn athm_client_request_request(request: &CxxAthmClientRequest) -> Vec<u8>;
+
+        fn athm_client_request_finalize(
+            request: &CxxAthmClientRequest,
+            public_key: &[u8],
+            response: &[u8],
+            params: &CxxAthmParameters,
+        ) -> Box<AthmBytesResult>;
+
+        fn token_request_decode(bytes: &[u8]) -> Box<AthmTokenRequestDecodeResult>;
+    }
+}
+
+struct CxxAthmKeyMaterial(AthmKeyMaterial);
+struct CxxAthmParameters(AthmParameters);
+struct CxxAthmClientRequest(AthmClientRequest);
+struct CxxTokenRequest(TokenRequest);
+
+struct AthmKeyMaterialNewResult(Option<Result<Box<CxxAthmKeyMaterial>, AthmStatus>>);
+struct AthmBytesResult(Option<Result<Vec<u8>, AthmStatus>>);
+struct AthmVerifyResult(Option<Result<u8, AthmStatus>>);
+struct AthmParametersNewResult(Option<Result<Box<CxxAthmParameters>, AthmStatus>>);
+struct AthmClientRequestNewResult(Option<Result<Box<CxxAthmClientRequest>, AthmStatus>>);
+struct AthmTokenRequestDecodeResult(Option<Result<Box<CxxTokenRequest>, AthmStatus>>);
+
+fn ffi_status(status: &AthmStatus) -> ffi::AthmStatus {
+    match status {
+        AthmStatus::InvalidInput => ffi::AthmStatus::InvalidInput,
+        AthmStatus::OperationFailed => ffi::AthmStatus::OperationFailed,
+    }
+}
+
+macro_rules! result_accessors {
+    ($err_fn:ident, $status_fn:ident, $unwrap_fn:ident, $wrapper:ident, $value:ty) => {
+        impl $wrapper {
+            fn $err_fn(&self) -> bool {
+                self.0
+                    .as_ref()
+                    .expect("result already consumed")
+                    .is_err()
+            }
+
+            fn $status_fn(&self) -> ffi::AthmStatus {
+                match self.0.as_ref().expect("result already consumed") {
+                    Ok(_) => ffi::AthmStatus::Ok,
+                    Err(status) => ffi_status(status),
+                }
+            }
+
+            fn $unwrap_fn(&mut self) -> $value {
+                self.0
+                    .take()
+                    .expect("result already consumed")
+                    .expect("unwrap called on an error")
+            }
+        }
+    };
+}
+
+result_accessors!(
+    athm_key_material_new_err,
+    athm_key_material_new_status,
+    athm_key_material_new_unwrap,
+    AthmKeyMaterialNewResult,
+    Box<CxxAthmKeyMaterial>
+);
+
+result_accessors!(
+    athm_bytes_result_err,
+    athm_bytes_result_status,
+    athm_bytes_result_unwrap,
+    AthmBytesResult,
+    Vec<u8>
+);
+
+result_accessors!(
+    athm_verify_result_err,
+    athm_verify_result_status,
+    athm_verify_result_unwrap,
+    AthmVerifyResult,
+    u8
+);
+
+result_accessors!(
+    athm_parameters_new_err,
+    athm_parameters_new_status,
+    athm_parameters_new_unwrap,
+    AthmParametersNewResult,
+    Box<CxxAthmParameters>
+);
+
+result_accessors!(
+    athm_client_request_new_err,
+    athm_client_request_new_status,
+    athm_client_request_new_unwrap,
+    AthmClientRequestNewResult,
+    Box<CxxAthmClientRequest>
+);
+
+result_accessors!(
+    token_request_decode_err,
+    token_request_decode_status,
+    token_request_decode_unwrap,
+    AthmTokenRequestDecodeResult,
+    Box<CxxTokenRequest>
+);
+
+fn athm_key_material_new(
+    num_buckets: u8,
+    deployment_id: &[u8],
+) -> Box<AthmKeyMaterialNewResult> {
+    Box::new(AthmKeyMaterialNewResult(Some(
+        AthmKeyMaterial::try_new(num_buckets, deployment_id)
+            .map(|value| Box::new(CxxAthmKeyMaterial(value))),
+    )))
+}
+
+fn athm_key_material_public_key(key_material: &CxxAthmKeyMaterial) -> Vec<u8> {
+    key_material.0.public_key()
+}
+
+fn athm_key_material_public_key_proof(key_material: &CxxAthmKeyMaterial) -> Vec<u8> {
+    key_material.0.public_key_proof()
+}
+
+fn athm_key_material_issue(
+    key_material: &CxxAthmKeyMaterial,
+    request: &CxxTokenRequest,
+    hidden_metadata: u8,
+) -> Box<AthmBytesResult> {
+    Box::new(AthmBytesResult(Some(
+        key_material.0.issue(&request.0, hidden_metadata),
+    )))
+}
+
+fn athm_key_material_verify(
+    key_material: &CxxAthmKeyMaterial,
+    token: &[u8],
+) -> Box<AthmVerifyResult> {
+    Box::new(AthmVerifyResult(Some(key_material.0.verify(token))))
+}
+
+fn athm_parameters_new(
+    num_buckets: u8,
+    deployment_id: &[u8],
+) -> Box<AthmParametersNewResult> {
+    Box::new(AthmParametersNewResult(Some(
+        AthmParameters::try_new(num_buckets, deployment_id)
+            .map(|value| Box::new(CxxAthmParameters(value))),
+    )))
+}
+
+fn athm_parameters_token_response_size(params: &CxxAthmParameters) -> usize {
+    params.0.token_response_size()
+}
+
+fn athm_client_request_new(
+    public_key: &[u8],
+    public_key_proof: &[u8],
+    params: &CxxAthmParameters,
+) -> Box<AthmClientRequestNewResult> {
+    Box::new(AthmClientRequestNewResult(Some(
+        AthmClientRequest::try_new(public_key, public_key_proof, &params.0)
+            .map(|value| Box::new(CxxAthmClientRequest(value))),
+    )))
+}
+
+fn athm_client_request_request(request: &CxxAthmClientRequest) -> Vec<u8> {
+    request.0.request()
+}
+
+fn athm_client_request_finalize(
+    request: &CxxAthmClientRequest,
+    public_key: &[u8],
+    response: &[u8],
+    params: &CxxAthmParameters,
+) -> Box<AthmBytesResult> {
+    Box::new(AthmBytesResult(Some(
+        request.0.finalize(public_key, response, &params.0),
+    )))
+}
+
+fn token_request_decode(bytes: &[u8]) -> Box<AthmTokenRequestDecodeResult> {
+    Box::new(AthmTokenRequestDecodeResult(Some(
+        TokenRequest::decode(bytes).map(|value| Box::new(CxxTokenRequest(value))),
+    )))
+}
