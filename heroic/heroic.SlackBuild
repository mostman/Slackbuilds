#  SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO,
#  PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS;
#  OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY,
#  WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR
#  OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF
#  ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.

cd $(dirname $0) ; CWD=$(pwd)

PRGNAMDEB=Heroic
PRGNAM=heroic
VERSION=${VERSION:-2.22.4}
BUILD=${BUILD:-1}
TAG=${TAG:-_SLse}

if [ -z "$ARCH" ]; then
  case "$( uname -m )" in
    i?86) ARCH=i586;;
    arm*) ARCH=arm;;
       *) ARCH=$( uname -m );DEBARCH="-amd64";;
  esac
fi

if [ "$ARCH" != "x86_64" ]; then
  echo "$ARCH is not supported."
  exit 1
fi

TMP=${TMP:-/tmp/SLse}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

set -eu

rm -rf $PKG
rm -rf $TMP/u3 $TMP/leg
mkdir -p $TMP $PKG $OUTPUT
cd $PKG
ar -p $CWD/${PRGNAMDEB}-${VERSION}-linux${DEBARCH}.deb data.tar.xz | tar -Jxv

# Prepare urllib3
mkdir -p $TMP/u3
pip download urllib3==1.26.20 --no-deps -d $TMP/u3
cd $TMP/u3 && unzip urllib3-1.26.20*.whl

# Patching for pythomn 3.9.x
cd $PKG/opt/Heroic/resources/app.asar.unpacked/build/bin/x64/linux/
mkdir $TMP/leg && cd $TMP/leg && unzip -q $OLDPWD/legendary
rm -rf urllib3 urllib3-*.dist-info
cp -r $TMP/u3/urllib3 .        # keep the unpacked 1.26.20 wheel next to the SlackBuild
for f in legendary/*.py legendary/*/*.py; do
  grep -q '^from __future__ import annotations' "$f" || sed -i '1i from __future__ import annotations' "$f"
done
python3 -m zipapp . -o $PKG/opt/Heroic/resources/app.asar.unpacked/build/bin/x64/linux/legendary -p "/usr/bin/env python3"
chmod +x $PKG/opt/Heroic/resources/app.asar.unpacked/build/bin/x64/linux/legendary

chown -R root:root .
find -L . \
 \( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 \
  -o -perm 511 \) -exec chmod 755 {} \; -o \
 \( -perm 666 -o -perm 664 -o -perm 640 -o -perm 600 -o -perm 444 \
  -o -perm 440 -o -perm 400 \) -exec chmod 644 {} \;

mkdir -p $PKG/usr/doc/$PRGNAM-$VERSION
mv $PKG/usr/share/doc/$PRGNAM/* $PKG/usr/doc/$PRGNAM-$VERSION
rm -rf $PKG/usr/share/doc
cat $CWD/$PRGNAM.SlackBuild > $PKG/usr/doc/$PRGNAM-$VERSION/$PRGNAM.SlackBuild

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc
cat $CWD/doinst.sh > $PKG/install/doinst.sh

cd $PKG
/sbin/makepkg -l y -c n $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.${PKGTYPE:-tgz}
